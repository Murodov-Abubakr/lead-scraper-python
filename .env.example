# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Identity ───────────────────────────────────────────────────────────────────
YOUR_NAME=Vicere

# ── Flask ──────────────────────────────────────────────────────────────────────
# Leave empty in production (Railway). Set to "1" for local debug mode only.
FLASK_DEBUG=
# Generated automatically if not set. Set a stable value in production.
SECRET_KEY=

# ── Dashboard & appointments password ─────────────────────────────────────────
# Protects /dashboard, /appointments, /api/stats
DASHBOARD_PASSWORD=change_me_before_deploy

# ── Chatbot email (booking notifications sent FROM this address) ───────────────
# Zoho: generate App Password at accounts.zoho.com → Security → App Passwords
SENDER_EMAIL=bot@vicere.co.uk
SENDER_PASSWORD=your_zoho_app_password

# ── Outreach email (cold email campaigns sent FROM this address) ───────────────
OUTREACH_EMAIL=hello@vicere.co.uk
OUTREACH_PASSWORD=your_zoho_app_password

# ── AI ─────────────────────────────────────────────────────────────────────────
# Google Gemini — used by the chatbot (aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key

# Groq — used by the scraper for email generation + link picking (console.groq.com)
GROQ_API_KEY=your_groq_api_key

# ── Lead generation APIs ───────────────────────────────────────────────────────
HUNTER_API_KEY=your_hunter_key
APOLLO_API_KEY=your_apollo_key
PLACES_API_KEY=your_google_places_key
PAGESPEED_API_KEY=your_pagespeed_key

# ── Database (Supabase — required in production) ──────────────────────────────
# Get this from: Supabase project → Settings → Database → Connection string → URI
# Replace [YOUR-PASSWORD] with your Supabase project password.
# Leave empty for local dev (will use analytics.json + appointments.csv instead).
DATABASE_URL=

# ── Supabase REST API (phone dashboard) ───────────────────────────────────────
# Get both from: Supabase → Project Settings → API
# SUPABASE_URL  — Project URL, e.g. https://xxxx.supabase.co
# SUPABASE_ANON_KEY — "anon public" key shown on the API settings page
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── Optional: Google Calendar integration ─────────────────────────────────────
# Share the clinic's Google Calendar with the service account email, then:
# GOOGLE_CALENDAR_ID=clinic@gmail.com
# CLINIC_TIMEZONE=Europe/London
