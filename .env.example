# Copy this file to .env and fill in your values.
# Never commit .env to git.

# ── Who you are ───────────────────────────────────────────────────────────────
YOUR_NAME=Salman Farisi

# ── SMTP sender ───────────────────────────────────────────────────────────────
# "gmail" or "zoho"
EMAIL_PROVIDER=gmail

# The address you'll send from
SENDER_EMAIL=you@gmail.com

# For Gmail: generate an App Password at https://myaccount.google.com/apppasswords
#   (requires 2-Step Verification to be turned on)
#   Use the 16-character code exactly — no spaces.
# For Zoho: generate at https://accounts.zoho.com/home#security → App Passwords
SENDER_PASSWORD=your_app_password_here
